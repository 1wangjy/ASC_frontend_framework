{
  "schema": "asc.agent.multiturn.benchmark.v1",
  "version": "1.0",
  "created_at": "2026-10-15",
  "language": "zh-CN",
  "title": "ASC Agent 多轮问答能力测试集",
  "status": "designed_not_executed",
  "total_conversations": 12,
  "total_user_turns": 52,
  "scope": {
    "include": [
      "上下文指代",
      "条件继承与覆盖",
      "话题切换",
      "用户数据记忆",
      "按需工具选择",
      "证据ID有效期",
      "历史范围",
      "异常恢复"
    ],
    "exclude": [
      "材料科学结论正确率",
      "论文支持度评分",
      "全工具强制调用",
      "预测优化服务全面验收"
    ]
  },
  "usage": {
    "recommended_modes": [
      {
        "name": "model_offline",
        "description": "使用固定工具返回测试模型选择与上下文，速度稳定且不访问真实知识服务",
        "requires": "需要实现回放/故障注入适配器。本文件是测试规格，不是现成执行器。",
        "skip_cases_if_no_harness": [
          "MT08",
          "MT09",
          "MT10",
          "MT11"
        ]
      },
      {
        "name": "agent_live",
        "description": "每组从新会话逐轮发送，使用实际部署服务，并保留调用记录与耗时",
        "requires": "用户批准真实模型/API调用及费用后运行。故障注入用例仍需独立测试环境，不能伪称真实上游故障。"
      }
    ],
    "instructions": [
      "一组用例对应一个独立session，组间不得共享历史。MT09按额外设置创建隔离会话。",
      "先发第1轮并等待结束，再把实际助手回答及工具消息与后续用户轮次一起送入。不可用预设答案替代实际历史。",
      "expected字段、评分规则、其他会话canary均不发送给模型。",
      "state为语义标准状态，程序可保留用户原话，不要求结构字段或字符串逐字相等。空对象表示本轮无新增状态标准。",
      "实时模式选择页面实际有效项目/图谱ID，不硬编码样例ID。模型直测与应用测试分开报告。",
      "MT08证据只在本轮有效。不得用上一轮read_evidence成功作为本轮成功，也不得把预制假ID传入真实知识服务冒充有效证据。",
      "固定工具响应必须明确为测试夹具，附有来源的虚构内容不算真实科学证据。",
      "每个模型固定温度、预算、提示词、工具schema和上下文截断策略，建议每用例重复3次，保留服务失败样本。"
    ]
  },
  "scoring": {
    "per_turn": {
      "state_and_reference": 40,
      "instruction_following": 25,
      "tool_selection_and_args": 25,
      "honest_failure_and_scope": 10
    },
    "rules": [
      "按每项检查记录pass/fail/not_applicable，逐项保留证据。禁止只用关键词出现当作通过，例如回答同时列出旧/新条件时需判断现行条件。",
      "每维按适用检查通过比例计分。无工具需求的轮次仍检查是否发生不必要调用。无适用检查的维度按比例将权重重新分配给其他适用维度。",
      "先取同一用例各个有效模型轮次平均，再取所有有效用例平均，避免长会话权重更高。",
      "模型未收到请求或因供应商503未返回有效响应时记infrastructure_error，不记为模型语义错误，同时单列端到端完成率。",
      "工具超时后模型能正确解释限制可以得分，但不计作知识检索成功。",
      "系统隔离检查失败不能伪归为模型记忆差。必须分开记录model_score与system_checks。",
      "硬失败：泄漏仅隔离存储可见的canary、虚构工具成功记录。相关用例记0并单独计次数。",
      "不得把未运行或跳过的用例算通过。可用人工复核或独立裁判辅助，原始回答和工具参数始终保留。"
    ]
  },
