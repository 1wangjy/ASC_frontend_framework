{
  "name": "asc-platform",
  "version": "1.0.0",
  "description": "ASC Platform - Node.js + Express service with vector search and LLM integration",
  "main": "src/index.js",
  "scripts": {
    "dev": "npm run start-mongo && node scripts/init-db.js && npx nodemon src/index.js",
    "start": "npm run start-mongo && node scripts/init-db.js && node src/index.js",
    "start-mongo": "node scripts/start-mongo.js",
    "stop-mongo": "node scripts/stop-mongo.js",
    "build": "echo 'Build completed'",
    "init-db": "node scripts/init-db.js",
    "gen-data": "node scripts/init-db.js && node scripts/add-example-data.js && node scripts/import-bibtex.js",
    "import-recipes": "node scripts/import-batch-recipes.js",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "node.js",
    "express",
    "vector-search",
    "llm",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "gridfs-stream": "^1.1.1",
    "helmet": "^8.1.0",
    "js-yaml": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongo-express": "^1.1.0-rc-4",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
