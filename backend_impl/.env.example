# ASC Platform 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3001

# 数据库类型: sqlite 或 mongodb
DB_TYPE=sqlite

# MongoDB 连接字符串（仅 DB_TYPE=mongodb 时需要）
MONGODB_URI=mongodb://localhost:27017/asc-platform

# JWT 密钥（请使用随机字符串）
JWT_SECRET=your-secret-key-change-this

# OpenAI API 密钥（用于 LLM 和 Embedding）
LLM_API_KEY=

# 本地 ML 模型服务地址
LOCAL_MODEL1_URL=http://localhost:8000/model1
LOCAL_MODEL2_URL=http://localhost:8001/model2
LOCAL_MODEL3_URL=http://localhost:8002/model3

# 运行环境: development 或 production
# development: API 不限流，便于本地联调
# production: 启用 /api/* 限流（每 IP 15 分钟最多 100 次请求）
NODE_ENV=development

# Python 命令路径（Windows 通常为 python，Linux/Mac 通常为 python3）
PYTHON_CMD=python

# Single-PDF literature metadata extraction (3001 backend only).
MISTRAL_API_KEY=
# The bundled script below is used by default, so this is normally unnecessary.
# PDF_METADATA_SCRIPT_PATH=D:\path\to\single_pdf_metadata.py
PDF_METADATA_TIMEOUT_MS=600000
PDF_METADATA_PROVIDER_TIMEOUT_SECONDS=300
