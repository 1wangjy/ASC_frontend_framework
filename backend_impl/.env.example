# ASC Platform 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3001

# 数据库类型: sqlite 或 mongodb
DB_TYPE=sqlite

# MongoDB 连接字符串（仅 DB_TYPE=mongodb 时需要）
MONGODB_URI=mongodb://localhost:27017/asc-platform

# JWT 密钥（请使用随机字符串）
JWT_SECRET=your-secret-key-change-this

# OpenAI API 密钥（用于 LLM 和 Embedding）
LLM_API_KEY=
LLM_API_URL=

# 本地 ML 模型服务地址
LOCAL_MODEL1_URL=http://localhost:8000/model1
LOCAL_MODEL2_URL=http://localhost:8001/model2
LOCAL_MODEL3_URL=http://localhost:8002/model3

# 运行环境: development 或 production
# development: API 不限流，便于本地联调
# production: 启用 /api/* 限流（每 IP 15 分钟最多 100 次请求）
NODE_ENV=development

# Python 命令路径（Windows 通常为 python，Linux/Mac 通常为 python3）
PYTHON_CMD=python

# Single-PDF literature metadata extraction (3001 backend only).
MISTRAL_API_KEY=
# The bundled script below is used by default, so this is normally unnecessary.
# PDF_METADATA_SCRIPT_PATH=D:\path\to\single_pdf_metadata.py
PDF_METADATA_TIMEOUT_MS=600000
PDF_METADATA_PROVIDER_TIMEOUT_SECONDS=300
PREDICT_BASE_URL=http://127.0.0.1:8100

# === 多轮对话 Agent (POST /api/agent/stream, /research?mode=multi) ===
# Agent 使用与上面相同的 OpenAI 兼容 LLM（LLM_API_URL + LLM_API_KEY，工具调用）。
AGENT_LLM_MODEL=deepseek-flash
# 知识图谱 / RAG 只读检索服务（CoD GraphRAG），默认 5001
AGENT_KG_BASE_URL=http://127.0.0.1:5001
# 配方优化模型：仅通过标准 API /api/model2/optimize 调用（默认指向本后端 3001）
AGENT_RECIPE_OPT_BASE_URL=http://127.0.0.1:3001
# 优化预算上限（昂贵：每次运行调用预测模型 N 次），默认 60
AGENT_RECIPE_OPT_MAX_BUDGET=60
# web_browse 主机白名单（逗号分隔；支持 *.example.com 通配）。未列出的主机一律禁止。
# 请求体 options.webAllowlist 只能在白名单内“收窄”，无法追加主机。
AGENT_WEB_ALLOWLIST=en.wikipedia.org,api.github.com,raw.githubusercontent.com
# 审计日志目录（NDJSON，每个工具调用一行；默认 backend_impl/data/agent，已 gitignore）
# AGENT_AUDIT_DIR=backend_impl/data/agent
# 会话持久化目录（每个会话一个 JSON；默认 backend_impl/data/agent/sessions，已 gitignore）。
# 写入是原子替换（tmp+rename），失败只告警，不会中断对话。目录不存在会自动创建。
# AGENT_SESSION_DIR=backend_impl/data/agent/sessions
# 单回合墙钟上限（毫秒，默认 300000 = 5 分钟；下限 50，上限 3600000）。
# 超时后先发 error{code:'turn_timeout'} 再发 done，并停止继续调用工具。
# AGENT_TURN_TIMEOUT_MS=300000
# 断线续传（POST /api/agent/stream + resumeFromEventId）的内存环形缓冲帧数，默认 200。
# 只存在于进程内存中：重启后端即失效（已落盘的会话不受影响，可用 GET /sessions/:id 恢复）。
# AGENT_SSE_BUFFER=200
# SSE keep-alive（`: ping`）间隔毫秒，默认 15000，最小 100。
# AGENT_SSE_HEARTBEAT_MS=15000
# recipe_optimize 单回合调用次数硬上限（昂贵操作；默认 1，上限 2）
# AGENT_RECIPE_OPT_MAX_CALLS=2
# 可选调优项（不填用默认值）
# AGENT_MAX_STEPS=6
# AGENT_WEB_TIMEOUT_MS=15000
# AGENT_WEB_MAX_BYTES=2097152
# AGENT_LLM_TIMEOUT_MS=180000
# AGENT_KG_TIMEOUT_MS=180000
# kg_graph 单次读取图谱响应的字节上限（/api/graph/data/<id> 无分页，返回整图），默认 32MB
# AGENT_KG_GRAPH_MAX_BYTES=33554432
# AGENT_PREDICT_TIMEOUT_MS=180000
# AGENT_RECIPE_OPT_TIMEOUT_MS=300000
